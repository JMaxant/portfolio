{{- /* RSS 2.0 feed of the home page, sections and tag terms. See docs/seo.md#feeds. */ -}}
{{- $pages := slice -}}
{{- if .IsHome -}}
  {{- $pages = where site.RegularPages "Section" "in" site.Params.mainSections -}}
{{- else if .IsSection -}}
  {{- $pages = .RegularPages -}}
{{- else -}}
  {{- $pages = .Pages -}}
{{- end -}}
{{- with site.Config.Services.RSS.Limit }}{{ if ge . 1 }}{{ $pages = $pages | first . }}{{ end }}{{ end -}}

{{- /* Same title and description as the page's <head>, so a reader shows what a visitor sees. */ -}}
{{- $title := cond .IsHome site.Title (printf "%s | %s" .Title site.Title) -}}
{{- $termDescription := cond (eq .Kind "term") (T "tag-description" (dict "Tag" .Title)) "" -}}
{{- $description := or .Description $termDescription .Summary site.Params.description -}}

{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ $title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $description | plainify | htmlUnescape | strings.TrimSpace }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- with site.Copyright }}
    <copyright>{{ . }}</copyright>
    {{- end }}
    {{- with $pages }}
    <lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- $entry := . }}
    <item>
      <title>{{ .Title }}</title>
      {{- /* A veille entry has no page of its own (build.render = 'link'): its Permalink is a
             404, so the item links to the source and keeps the Permalink as an opaque id. */}}
      {{- with .Params.source_link }}
      <link>{{ . }}</link>
      <guid isPermaLink="false">{{ $entry.Permalink }}</guid>
      {{- else }}
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      {{- end }}
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <description>{{ or .Description .Summary | plainify | htmlUnescape | strings.TrimSpace }}</description>
      <content:encoded>{{ `<![CDATA[` | safeHTML }}{{ .Content | safeHTML }}{{ `]]>` | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
